        self.frame_timer += 1
        self.state_timer -= 1
        
        if self.state == 'IDLE':
            self.image = self.frames_pauline[0]
            if self.state_timer <= 0:
                self.state = 'HELP'
                self.state_timer, self.index, self.frame_timer = random.randint(90, 150), 0, 0
                
        elif self.state == 'HELP':
            if self.frame_timer >= self.speed_anim // 2: 
                self.frame_timer = 0
                self.index = (self.index + 1) % len(self.frames_pauline)
                self.image = self.frames_pauline[self.index]
                
            if self.state_timer <= 0:
                self.state = 'IDLE'
                self.state_timer, self.index, self.frame_timer = random.randint(150, 300), 0, 0

class DonkeyKong(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.w, self.h = 48, 48
        # kong_st, kong_atk1, etc., ya están cargadas en el bloque anterior
        self.anim_stand = [pygame.transform.scale(kong_st, (self.w, self.h))]
        self.anim_attack = [pygame.transform.scale(img, (self.w, self.h)) for img in (kong_atk1, kong_atk2)]
        self.anim_chest = [pygame.transform.scale(img, (self.w, self.h)) for img in (kong_ch1, kong_ch2)]
        self.anim_pickup = [pygame.transform.scale(kong_get, (self.w, self.h))]
        self.anim_hold = [pygame.transform.scale(kong_hold, (self.w, self.h))]
        
        self.image = self.anim_stand[0]
        self.rect = self.image.get_rect(topleft=(x, y))
        self.state = 'STAND' 
        self.frame_timer, self.index, self.speed_anim = 0, 0, 4  
        self.action_timer = random.randint(35, 65)  
        self.state_duration = 0 
        self.lanzar_ahora, self.primer_barril_lanzado = False, False 
        self.proximo_azul = True  

    def update(self):
        self.frame_timer += 1
        if self.state == 'STAND':
            self.image = self.anim_stand[0]
            self.action_timer -= 1
            if self.action_timer <= 0:
                if random.random() < 0.85:
                    self.state, self.state_duration = 'PICKUP', 20  
                    self.proximo_azul = not self.primer_barril_lanzado 
                else:
                    self.state, self.index = 'CHEST', 0
                    self.state_duration = random.randint(30, 50) 
                self.frame_timer = 0
        elif self.state == 'PICKUP':
            self.image = self.anim_pickup[0]
            self.state_duration -= 1
            if self.state_duration <= 0:
                self.state, self.state_duration = 'HOLD', 20  
        elif self.state == 'HOLD':
            self.image = self.anim_hold[0]
            self.state_duration -= 1
            if self.state_duration <= 0:
                self.state, self.index, self.frame_timer = 'THROW', 0, 0
                self.image = self.anim_attack[0] 
        elif self.state == 'THROW':
            if self.frame_timer >= self.speed_anim:
                self.frame_timer = 0
                self.index += 1
                if self.index < len(self.anim_attack):
                    self.image = self.anim_attack[self.index]
                else:
                    self.lanzar_ahora, self.state = True, 'STAND'
                    self.action_timer, self.index = random.randint(35, 75), 0  
        elif self.state == 'CHEST':
            if self.frame_timer >= self.speed_anim:
                self.frame_timer = 0
                self.index = (self.index + 1) % len(self.anim_chest)
                self.image = self.anim_chest[self.index]
            self.state_duration -= 1
            if self.state_duration <= 0:
                self.state, self.action_timer = 'STAND', random.randint(35, 65)

class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.w, self.h = 28, 28  
        self.img_quieto = pygame.transform.scale(pygame.image.load(MARIO_DIR + "mario.png").convert_alpha(), (self.w, self.h))
        self.anim_caminar = [pygame.transform.scale(pygame.image.load(MARIO_DIR + f"caminar{i}.png").convert_alpha(), (self.w, self.h)) for i in (1, 2)]
        self.anim_escalar = [pygame.transform.scale(pygame.image.load(MARIO_DIR + f"escalar{i}.png").convert_alpha(), (self.w, self.h)) for i in (1, 2)]
        
        self.martillo_quieto = [pygame.transform.scale(pygame.image.load(MARIO_DIR + f"martillo{i}.png").convert_alpha(), (self.w + 28, self.h + 28)) for i in (1, 2)]
        self.martillo_caminar = [pygame.transform.scale(pygame.image.load(MARIO_DIR + f"martillo{i}.png").convert_alpha(), (self.w + 28, self.h + 28)) for i in range(3, 7)]

        self.image = self.img_quieto
        self.rect = self.image.get_rect()
        self.rect.height, self.rect.x, self.rect.y = 24, MARGIN + 50, 616
        self.change_x, self.change_y, self.gravity = 0, 0, 0.45
        self.on_ladder, self.climbing, self.is_jumping = False, False, False  
        self.direction, self.index, self.frame_timer, self.speed_anim = "R", 0, 0, 3  
        self.has_hammer, self.hammer_timer = False, 0

        self.imagen_salto_der = pygame.transform.scale(pygame.image.load(MARIO_DIR + "salto.png").convert_alpha(), (28, 24))
        self.imagen_salto_izq = pygame.transform.flip(self.imagen_salto_der, True, False)

    def update(self, platforms, ladders, walls):
        self.rect.width, self.rect.height = 28, 24

        if self.has_hammer:
            self.hammer_timer -= 1
            if self.hammer_timer <= 0: self.has_hammer = False

        # 🌟 NUEVO: Guardamos el estado anterior para saber si acaba de salir de la escalera
        was_climbing = self.climbing  
        self.on_ladder = bool(pygame.sprite.spritecollide(self, ladders, False))
        
        if not self.on_ladder: 
            self.climbing = False  
            # Detenemos el falso salto al llegar arriba de la escalera
            if was_climbing and self.change_y < 0:
                self.change_y = 0

        # 🌟 NUEVO: Fiel al arcade, no te puedes mover a los lados mientras escalas
        if self.climbing:
            self.change_x = 0

        if not self.climbing:
            self.change_y = min(self.change_y + self.gravity, 8)  

        self.rect.x += self.change_x
        if self.rect.left < MARGIN: self.rect.left = MARGIN
        if self.rect.right > SCREEN_WIDTH - MARGIN: self.rect.right = SCREEN_WIDTH - MARGIN
        
        for wall in pygame.sprite.spritecollide(self, walls, False):
            if self.change_x > 0: self.rect.right = wall.rect.left
            elif self.change_x < 0: self.rect.left = wall.rect.right

        self.rect.y += self.change_y
        if self.rect.top < MARGIN: self.rect.top = MARGIN
        if self.rect.bottom > SCREEN_HEIGHT: 
            self.rect.bottom, self.is_jumping, self.change_y = SCREEN_HEIGHT, False, 0

        # --- SISTEMA DE COLISIONES CON VIGAS CORREGIDO ---
        if not self.climbing:
            for block in pygame.sprite.spritecollide(self, platforms, False):
                if self.change_y > 0:  # Si Mario está cayendo
                    if self.rect.bottom <= block.rect.bottom + 12:
                        self.rect.bottom = block.rect.top
                        self.change_y = 0
                        self.is_jumping = False
                elif self.change_y < 0:  # Si Mario está subiendo (saltando)
                    # 🌟 NUEVO: Solo choca la cabeza si está verdaderamente debajo de la viga
                    if block.rect.bottom - 15 <= self.rect.top < block.rect.bottom:
                        self.rect.top = block.rect.bottom  
                        self.change_y = 0                  
            
            if self.change_y == 0: 
                self.is_jumping = False
                
        self.animate()

        if self.is_jumping and not self.has_hammer:
            self.image = self.imagen_salto_izq if self.direction == "L" else self.imagen_salto_der

    def jump(self):
        if not self.is_jumping: 
            self.is_jumping, self.change_y = True, -5.8 
            canal_salto.play(sonido_salto) 

    def animate(self):
        if self.has_hammer:
            self.frame_timer += 1
            if self.change_x != 0:
                if self.index >= len(self.martillo_caminar): self.index = 0
                if self.frame_timer >= 5: 
                    self.frame_timer, self.index = 0, (self.index + 1) % len(self.martillo_caminar)
                frame_actual = self.martillo_caminar[self.index]
            else:
                if self.index >= len(self.martillo_quieto): self.index = 0
                if self.frame_timer >= 5: 
                    self.frame_timer, self.index = 0, (self.index + 1) % len(self.martillo_quieto)
                frame_actual = self.martillo_quieto[self.index]
            self.image = pygame.transform.flip(frame_actual, True, False) if self.direction == "L" else frame_actual

        elif self.climbing and self.change_y != 0:
            self.frame_timer += 1
            if self.frame_timer >= self.speed_anim:
                self.frame_timer, self.index = 0, (self.index + 1) % len(self.anim_escalar)
                self.image = self.anim_escalar[self.index]
        elif self.climbing and self.change_y == 0:
            self.image = self.anim_escalar[self.index]
        elif self.change_x != 0 and self.change_y == 0:
            self.frame_timer += 1
            if self.frame_timer >= self.speed_anim:
                self.frame_timer, self.index = 0, (self.index + 1) % len(self.anim_caminar)
                frame_actual = self.anim_caminar[self.index]
                self.image = pygame.transform.flip(frame_actual, True, False) if self.direction == "L" else frame_actual
        elif self.change_x == 0 and self.change_y == 0:
            self.image = pygame.transform.flip(self.img_quieto, True, False) if self.direction == "L" else self.img_quieto
        
        if self.is_jumping and not self.has_hammer:
            self.image = pygame.transform.flip(self.img_quieto, True, False) if self.direction == "L" else self.img_quieto

    # 🌟 NUEVO: Protegemos el movimiento lateral para que no se resbale de la escalera
    def go_left(self): 
        if not self.climbing: self.change_x, self.direction = -1.8, "L" 
    def go_right(self): 
        if not self.climbing: self.change_x, self.direction = 2.5, "R"
        
    def go_up(self): 
        if self.on_ladder and not self.has_hammer: self.climbing, self.change_y = True, -1
    def go_down(self): 
        if self.on_ladder and not self.has_hammer: self.climbing, self.change_y = True, 1
    def stop_x(self): self.change_x = 0
    def stop_y(self): 
        if self.climbing: self.change_y = 0
        
