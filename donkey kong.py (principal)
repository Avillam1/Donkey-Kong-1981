class Platform(pygame.sprite.Sprite):
    def __init__(self, x, y, width, height, texture):
        super().__init__()
        self.image = pygame.Surface((width, height), pygame.SRCALPHA)
        self.rect = self.image.get_rect(topleft=(x, y))
        scaled_texture = pygame.transform.scale(texture, (texture.get_width(), height))
        for i in range(0, width, scaled_texture.get_width()):
            self.image.blit(scaled_texture, (i, 0))

class Ladder(pygame.sprite.Sprite):
    def __init__(self, x, y, width, height, texture):
        super().__init__()
        self.image = pygame.Surface((width, height), pygame.SRCALPHA)
        self.rect = self.image.get_rect(topleft=(x, y))
        scaled_texture = pygame.transform.scale(texture, (width, texture.get_height()))
        for i in range(0, height, scaled_texture.get_height()):
            self.image.blit(scaled_texture, (0, i))

