class Barrel(pygame.sprite.Sprite):
    def __init__(self, x, y, is_blue=False):
        super().__init__()
        self.w, self.h = 24, 24  
        self.is_blue = is_blue 
        self.ya_saltado = False

        if self.is_blue:
            self.anim_rodar = [pygame.transform.scale(pygame.image.load(BARRILES_DIR + f"barrilazul{i}.png").convert_alpha(), (self.w, self.h)) for i in (1, 2)]
            self.change_x, self.change_y, self.is_descending, self.SUELO_Y = 0, 4, True, 640  
        else:
            self.anim_rodar = [pygame.transform.scale(pygame.image.load(BARRILES_DIR + f"barril{i}.png").convert_alpha(), (self.w, self.h)) for i in (1, 2, 3)]
            self.change_x, self.change_y, self.is_descending = 2, 0, False

        self.image = self.anim_rodar[0]
        self.rect = self.image.get_rect(topleft=(x, y))
        self.cooldown_escalera, self.frame_timer, self.index = 0, 0, 0  
        self.escalera_evaluada = False 

    def update(self, platforms, ladders):
        if self.cooldown_escalera > 0: self.cooldown_escalera -= 1

        if not self.is_descending:
            self.rect.x += self.change_x
            escaleras_tocadas = pygame.sprite.spritecollide(self, ladders, False)
            
            if escaleras_tocadas:
                if not self.escalera_evaluada and self.cooldown_escalera == 0:
                    escalera = escaleras_tocadas[0]
                    if abs(self.rect.bottom - escalera.rect.top) <= 12:
                        self.escalera_evaluada = True 
                        if random.random() < 0.60: 
                            self.is_descending = True
                            self.rect.centerx = escalera.rect.centerx
                            self.change_x, self.change_y = 0, 3
            else:
                self.escalera_evaluada = False

            self.rect.y += 6  
            platform_hits = pygame.sprite.spritecollide(self, platforms, False)
            self.rect.y -= 6
            
            if platform_hits:
                viga_actual = min(platform_hits, key=lambda p: abs(self.rect.centerx - p.rect.centerx))
                self.rect.bottom = viga_actual.rect.top + 4
            else:
                self.is_descending, self.change_x, self.change_y = True, 0, 3  

            if self.rect.left < MARGIN:
                self.rect.left, self.change_x = MARGIN, -self.change_x
            if self.rect.right > SCREEN_WIDTH - MARGIN:
                self.rect.right, self.change_x = SCREEN_WIDTH - MARGIN, -self.change_x

        else:
            self.rect.y += self.change_y
            platform_hit_list = pygame.sprite.spritecollide(self, platforms, False)
            
            if self.is_blue:
                if self.rect.bottom >= self.SUELO_Y - 10:
                    for block in platform_hit_list:
                        if block.rect.y >= 619: 
                            self.is_descending = False
                            self.rect.bottom = block.rect.top + 4
                            self.change_x, self.change_y = -2.5, 0  
                            break
            else:
                for block in platform_hit_list:
                    if block.rect.top <= self.rect.bottom <= block.rect.top + self.change_y + 1:
                        self.is_descending, self.escalera_evaluada = False, False
                        self.cooldown_escalera = 60 
                        self.change_x = -2 if self.rect.x > SCREEN_WIDTH // 2 else 2
                        self.rect.bottom, self.change_y = block.rect.top + 4, 0
                        break 

        self.frame_timer += 1
        if self.frame_timer >= 4:  
            self.frame_timer = 0
            self.index = (self.index + 1) % len(self.anim_rodar)
            self.image = self.anim_rodar[self.index]

