class Fireball(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.w, self.h = 24, 24
        self.anim_fuego = [pygame.transform.scale(pygame.image.load(BARRILES_DIR + f"fuego{i}.png").convert_alpha(), (self.w, self.h)) for i in (1, 2)]
        self.anim_panico = [pygame.transform.scale(pygame.image.load(BARRILES_DIR + f"fuegoazul{i}.png").convert_alpha(), (self.w, self.h)) for i in (1, 2)]
        
        self.image = self.anim_fuego[0]
        self.rect = self.image.get_rect(topleft=(x, y))
        self.pos_x = float(x) 
        self.change_x, self.change_y, self.gravity = 1.2, -4.5, 0.5
        self.in_arc, self.activa = True, False
        self.frame_timer, self.index, self.speed_anim, self.timer_nacimiento = 0, 0, 8, 0

    def update(self, platforms, mario_has_hammer):
        if not self.activa:
            self.timer_nacimiento += 1
            if self.timer_nacimiento > 40: self.activa = True

        if self.in_arc:
            self.pos_x += self.change_x
            self.rect.x = int(self.pos_x)
            self.change_y += self.gravity
            self.rect.y += self.change_y
            
            platform_hits = pygame.sprite.spritecollide(self, platforms, False)
            if platform_hits and self.change_y > 0:
                highest_platform = min(platform_hits, key=lambda p: p.rect.top)
                if self.rect.bottom >= highest_platform.rect.top:
                    self.rect.bottom = highest_platform.rect.top
                    self.in_arc = False
                    self.change_x, self.change_y = 1.5, 0
        else:
            self.pos_x += self.change_x
            self.rect.x = int(self.pos_x)
            
            self.rect.y += 15
            platform_hits = pygame.sprite.spritecollide(self, platforms, False)
            self.rect.y -= 15
            if platform_hits:
                self.rect.bottom = min(platform_hits, key=lambda p: p.rect.top).rect.top
            
            if self.rect.left < MARGIN or self.rect.right > SCREEN_WIDTH - MARGIN:
                self.change_x = -self.change_x

