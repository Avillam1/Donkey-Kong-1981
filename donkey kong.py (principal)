def cargar_mapa(num_nivel):
    for p in platforms: p.kill()
    for l in ladders: l.kill()
    for m in mario_only_ladders: m.kill()
    for iw in invisible_walls: iw.kill()
    for db in decorative_barrels: db.kill() 
    
    platforms.empty()
    ladders.empty()
    mario_only_ladders.empty()
    invisible_walls.empty()
    decorative_barrels.empty() 
    
    vigas_nivel = []
    escaleras_nivel = []
    escaleras_mario_nivel = []
    paredes_invisible_data = []
    
    pos_mono = (0, 0)
    pos_pauline = (0, 0)
    barriles_deco_data = []
    
    if num_nivel == 1:
        vigas_nivel = [Platform(*c, texture=platform_texture) for c in mapas.NIVEL_1_VIGAS]
        escaleras_nivel = [Ladder(*c, texture=ladder_texture) for c in mapas.NIVEL_1_ESCALERAS]
        escaleras_mario_nivel = [Ladder(*c, texture=ladder_texture) for c in mapas.NIVEL_1_ESCALERAS_MARIO]
        paredes_invisible_data = mapas.NIVEL_1_PAREDES_INVISIBLES
        pos_mono = mapas.NIVEL_1_MONO
        pos_pauline = mapas.NIVEL_1_PAULINE
        barriles_deco_data = mapas.NIVEL_1_BARRILES_DECO

    elif num_nivel == 2:
        vigas_nivel = [Platform(*c, texture=platform_texture) for c in mapas.NIVEL_2_VIGAS]
        escaleras_nivel = [Ladder(*c, texture=ladder_texture) for c in mapas.NIVEL_2_ESCALERAS]
        escaleras_mario_nivel = [Ladder(*c, texture=ladder_texture) for c in mapas.NIVEL_2_ESCALERAS_MARIO]
        paredes_invisible_data = mapas.NIVEL_2_PAREDES_INVISIBLES
        pos_mono = mapas.NIVEL_2_MONO
        pos_pauline = mapas.NIVEL_2_PAULINE
        barriles_deco_data = mapas.NIVEL_2_BARRILES_DECO

    elif num_nivel == 3:
        vigas_nivel = [Platform(*c, texture=platform_texture) for c in mapas.NIVEL_3_VIGAS]
        escaleras_nivel = [Ladder(*c, texture=ladder_texture) for c in mapas.NIVEL_3_ESCALERAS]
        escaleras_mario_nivel = [Ladder(*c, texture=ladder_texture) for c in mapas.NIVEL_3_ESCALERAS_MARIO]
        paredes_invisible_data = mapas.NIVEL_3_PAREDES_INVISIBLES
        pos_mono = mapas.NIVEL_3_MONO
        pos_pauline = mapas.NIVEL_3_PAULINE
        barriles_deco_data = mapas.NIVEL_3_BARRILES_DECO
    
    for viga in vigas_nivel:
        platforms.add(viga)
        all_sprites.add(viga)

    for escalera in escaleras_nivel:
        ladders.add(escalera)
        all_sprites.add(escalera)

    for esc_mario in escaleras_mario_nivel:
        mario_only_ladders.add(esc_mario)
        all_sprites.add(esc_mario)

    for c in paredes_invisible_data:
        pared = InvisibleWall(*c) 
        invisible_walls.add(pared)

    # Reubicación dinámica de personajes
    if 'mono' in globals():
        mono.rect.x = pos_mono[0]
        mono.rect.y = pos_mono[1]
        
    if 'pauline' in globals():
        pauline.rect.x = pos_pauline[0]
        pauline.rect.y = pos_pauline[1]
        
    for c in barriles_deco_data:
        barril_falso = DecorativeBarrel(*c)
        decorative_barrels.add(barril_falso)
        all_sprites.add(barril_falso)


def animacion_muerte(mirando_derecha):
    pygame.event.clear()
    pygame.mixer.music.stop()       
    if canal_martillo.get_busy(): canal_martillo.stop()
    if canal_caminar.get_busy(): canal_caminar.stop()       
    sonido_muerte.play()
    
    for b in barrels.sprites(): b.kill()
    for f in fireballs.sprites(): f.kill()
    for d in drum_flames.sprites(): d.kill()
    barrels.empty()
    fireballs.empty()
    drum_flames.empty()
    
    frames_giro = sprites_muerte[:4]
    frame_final = sprites_muerte[4]

    for _ in range(3):
        for frame in frames_giro:
            screen.fill(BLACK)
            screen.blit(background_image, (MARGIN, 0))
            for sprite in all_sprites:
                if sprite != player: 
                    screen.blit(sprite.image, sprite.rect)
            
            frame_render = frame if mirando_derecha else pygame.transform.flip(frame, True, False)
            screen.blit(frame_render, player.rect)
            pygame.display.flip()
            pygame.time.delay(150) 
            
    screen.fill(BLACK)
    screen.blit(background_image, (MARGIN, 0))
    for sprite in all_sprites:
        if sprite != player: 
            screen.blit(sprite.image, sprite.rect)
            
    ultimo_actual = frame_final if mirando_derecha else pygame.transform.flip(frame_final, True, False)
    screen.blit(ultimo_actual, player.rect)
    pygame.display.flip() 
    
    pygame.time.wait(2000)
    screen.fill((0, 0, 0)) 
    pygame.display.flip()
    pygame.time.wait(1500)


def reiniciar_nivel():
    global puntos_activos, combo_martillo, mono, pauline, bonus, contador_frames_bonus
    
    barrels.empty()
    fireballs.empty()
    drum_flames.empty()
    puntos_activos = []
    combo_martillo = 0
    
    # Recrear barriles decorativos según el nivel activo
    for bd in decorative_barrels.sprites(): bd.kill()
    decorative_barrels.empty()

    coordenadas_decorativos = []
    if nivel == 1: 
        coordenadas_decorativos = mapas.NIVEL_1_BARRILES_DECO  
    elif nivel == 2: 
        coordenadas_decorativos = mapas.NIVEL_2_BARRILES_DECO  
    elif nivel == 3: 
        coordenadas_decorativos = mapas.NIVEL_3_BARRILES_DECO  
    
