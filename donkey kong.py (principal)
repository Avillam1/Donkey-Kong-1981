    mono.kill()
    pauline.kill()
    
    if nivel == 1:
        pos_mono = mapas.NIVEL_1_MONO
        pos_pauline = mapas.NIVEL_1_PAULINE
    elif nivel == 2:
        pos_mono = mapas.NIVEL_2_MONO
        pos_pauline = mapas.NIVEL_2_PAULINE
    elif nivel == 3:
        pos_mono = mapas.NIVEL_3_MONO
        pos_pauline = mapas.NIVEL_3_PAULINE

    mono = DonkeyKong(pos_mono[0], pos_mono[1])
    all_sprites.add(mono)
    
    pauline = Pauline(pos_pauline[0], pos_pauline[1])
    all_sprites.add(pauline)
    
    bonus = 5000
    contador_frames_bonus = 0
    
    if hasattr(oil_drum, 'encendido'):
        oil_drum.encendido = False

    player.rect.x = MARGIN + 50
    player.rect.y = 616
    player.stop_x()
    player.stop_y()
    player.has_hammer = False
    player.climbing = False
    player.is_jumping = False
    player.mirando_derecha = True
    
    if hasattr(player, 'image_standing'):
        player.image = player.image_standing
    elif hasattr(player, 'sprites_derecha') and len(player.sprites_derecha) > 0:
        player.image = player.sprites_derecha[0]

    pygame.mixer.music.stop()
    if canal_martillo.get_busy(): canal_martillo.stop()
    if canal_caminar.get_busy(): canal_caminar.stop()
    pygame.event.clear()

    screen.fill(BLACK)
    screen.blit(background_image, (MARGIN, 0))
    for sprite in all_sprites:
        if sprite != player: 
            screen.blit(sprite.image, sprite.rect)
    screen.blit(player.image, player.rect)
    pygame.display.flip()

    sonido_inicio_nivel.play()
    pygame.time.wait(3000)

    pygame.mixer.music.load(f"{ASSETS_DIR}/musicfondo.mp3")
    pygame.mixer.music.set_volume(0.4) 
    pygame.mixer.music.play(-1)

juego_abierto = True

while juego_abierto:
    
    # 1. REINICIO DE VARIABLES GLOBALES PARA CADA PARTIDA
    mostrar_paredes = False
    vidas = 3
    nivel = 1
    bonus = 5000
    contador_frames_bonus = 0
    juego_terminado = False
    victoria = False
    corazon_creado = False
    llamas_creadas = False 
    puntos_activos = []
    combo_martillo = 0
    tiempo_cierre_victoria = 0

    esperando_inicio = True  # 🌟 FIJADO: Antes estaba en False y se saltaba el menú
    imagen_menu = pygame.transform.scale(pygame.image.load(f"{ASSETS_DIR}/DKScreen.png").convert(), (screen.get_width(), screen.get_height()))
    pygame.mixer.music.load(f"{ASSETS_DIR}/menu.mp3")
    pygame.mixer.music.set_volume(0.5)
    pygame.mixer.music.play() 

    tiempo_inicial = pygame.time.get_ticks()
    reproduciendo = True
    rect_boton_player = pygame.Rect(100, 410, 260, 30)

    while esperando_inicio:
        tiempo_actual = pygame.time.get_ticks()
        tiempo_transcurrido = tiempo_actual - tiempo_inicial

        if reproduciendo and tiempo_transcurrido >= 15000:
            pygame.mixer.music.stop()
            reproduciendo = False
        elif not reproduciendo and tiempo_transcurrido >= 20000:
            pygame.mixer.music.play()
            tiempo_inicial = pygame.time.get_ticks() 
            reproduciendo = True

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                # --- AQUÍ APLICAMOS LA INTEGRACIÓN PARA CERRAR LIMPIO ---
                esperando_inicio = False
                juego_abierto = False
                
            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                if rect_boton_player.collidepoint(event.pos):
                    pygame.mixer.music.stop()
                    sonido_inicio.play()
                    pygame.time.wait(int(sonido_inicio.get_length() * 1000))
                    esperando_inicio = False  

        # Si el usuario cerró la ventana, salir del while interno inmediatamente
        if not juego_abierto:
            break

        pos_x = screen.get_width() // 2 - imagen_menu.get_width() // 2
        pos_y = screen.get_height() // 2 - imagen_menu.get_height() // 2
        screen.fill((0, 0, 0)) 
        screen.blit(imagen_menu, (pos_x, pos_y))
        pygame.display.flip()
        clock.tick(60) # Esto es vital para que el juego no sature el procesador

    # Evitamos cargar el nivel si ya se mandó a cerrar el juego
    if not juego_abierto:
        break

    cargar_mapa(nivel)
    reiniciar_nivel()

    running = True
    tiempo_cierre_victoria = 0
    pausado = False  # 🌟 NUEVO: Variable para controlar la pausa

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT: 
                running = False
                juego_abierto = False
            
            if not juego_terminado and not victoria:
                if event.type == pygame.KEYDOWN:
                    # 🌟 NUEVO: Control de la tecla de pausa
                    if event.key == pygame.K_p: 
                        pausado = not pausado
                        if pausado:
                            pygame.mixer.music.pause()
                            if canal_caminar.get_busy(): canal_caminar.pause()
                            if canal_martillo.get_busy(): canal_martillo.pause()
                        else:
                            pygame.mixer.music.unpause()
                            if canal_caminar.get_busy(): canal_caminar.unpause()
                            if canal_martillo.get_busy(): canal_martillo.unpause()

                    # Solo registrar comandos de movimiento si NO está pausado
                    if not pausado:
                        if event.key == pygame.K_LEFT: 
                            player.go_left()
                            player.mirando_derecha = False 
                        if event.key == pygame.K_RIGHT: 
                            player.go_right()
                            player.mirando_derecha = True  
                        if event.key == pygame.K_UP: player.go_up()
                        if event.key == pygame.K_DOWN: player.go_down()
                        if event.key == pygame.K_SPACE: player.jump()
                
                if event.type == pygame.KEYUP:
                    if event.key == pygame.K_LEFT and player.change_x < 0: player.stop_x()
                    if event.key == pygame.K_RIGHT and player.change_x > 0: player.stop_x()
                    if event.key == pygame.K_UP and player.change_y < 0: player.stop_y()
                    if event.key == pygame.K_DOWN and player.change_y > 0: player.stop_y()

        if not running:
            break

        if not juego_terminado:
            if not victoria:
                if not pausado:
                    # Lógica del Bonus de Tiempo
                    contador_frames_bonus += 1
                    if contador_frames_bonus >= 60:
                        contador_frames_bonus = 0
                        if bonus > 0:
                            bonus -= 100
                        elif not modo_dios: 
                            vidas -= 1
                            animacion_muerte(player.mirando_derecha)
                            if vidas <= 0: 
                                juego_terminado = True
                            else:
                                reiniciar_nivel()

                    if not getattr(player, 'has_hammer', False):
                        combo_martillo = 0
                        if canal_martillo.get_busy():
                            canal_martillo.stop()
                            pygame.mixer.music.unpause()
                            
                    player.update(platforms, ladders.sprites() + mario_only_ladders.sprites(), invisible_walls)  
                    barrels.update(platforms, ladders.sprites() + mario_only_ladders.sprites())
                    fireballs.update(platforms, player.has_hammer) 
                    drum_flames.update()
                    mono.update()                                                                                                                                                                                                                                                                                                                                                                                                                                     
                    pauline.update()                                                                                                                                                                                                                                                                                                                                                                                                                                  
                    letrero_help.update()

                    if abs(player.change_x) > 0 and not player.climbing and not getattr(player, 'is_jumping', False):
                        if not canal_caminar.get_busy(): canal_caminar.play(sonido_caminar, loops=-1)
                    else:
                        canal_caminar.stop()

                    if mono.lanzar_ahora:
                        if len(barrels) < 8:  
                            pos_x = mono.rect.centerx - 12 if mono.proximo_azul else mono.rect.right - 10
                            nuevo_barril = Barrel(pos_x, mono.rect.bottom - 24, is_blue=mono.proximo_azul)
                            barrels.add(nuevo_barril)
                            all_sprites.add(nuevo_barril)
                            if not mono.primer_barril_lanzado: mono.primer_barril_lanzado = True
                        mono.lanzar_ahora = False
                
                    hammer_hits = pygame.sprite.spritecollide(player, hammers, True)
                    for hammer in hammer_hits:
                        player.has_hammer = True
                        player.hammer_timer = 720  
                        pygame.mixer.music.pause()
                        if not canal_martillo.get_busy(): canal_martillo.play(sonido_martillo, loops=-1)

                    for barril in barrels:
                        alineado_horizontalmente = abs(player.rect.centerx - barril.rect.centerx) < 20
                        if alineado_horizontalmente and player.is_jumping and player.rect.bottom <= barril.rect.top + 15:
                            if not getattr(barril, 'ya_saltado', False):
                                barril.ya_saltado = True
                                puntos_activos.append({
                                    'rect': imagen_puntos_100.get_rect(centerx=player.rect.centerx, bottom=player.rect.top - 15),
                                    'timer': 60, 'image': imagen_puntos_100, 'texto': "+100"
                                })

                        if player.rect.colliderect(barril.rect.inflate(-4, -4)):
                            if getattr(player, 'has_hammer', False):
                                combo_martillo += 1
                                img_actual, texto_actual = (imagen_puntos_300, "+300") if combo_martillo == 1 else (imagen_puntos_500, "+500")
                                puntos_activos.append({
                                    'rect': img_actual.get_rect(centerx=barril.rect.centerx, bottom=barril.rect.top - 15),
                                    'timer': 60, 'image': img_actual, 'texto': texto_actual
                                })
                                barril.kill()
                            elif not modo_dios: 
                                vidas -= 1
                                animacion_muerte(player.mirando_derecha)
                                if vidas <= 0: 
                                    juego_terminado = True
                                else:
                                    reiniciar_nivel()
                                break

                    for barril in pygame.sprite.spritecollide(oil_drum, barrels, False):
                        if getattr(barril, 'is_blue', False):
                            if hasattr(oil_drum, 'encendido'): oil_drum.encendido = True 
                            nuevo_fuego = Fireball(oil_drum.rect.centerx, oil_drum.rect.top - 10)
                            fireballs.add(nuevo_fuego)
                            all_sprites.add(nuevo_fuego)
                        barril.kill()

                    for fuego in fireballs:
                        if not fuego.in_arc and fuego.activa and player.rect.colliderect(fuego.rect):
                            if getattr(player, 'has_hammer', False):
                                fuego.kill()
                            elif not modo_dios: 
                                vidas -= 1
                                animacion_muerte(player.mirando_derecha)
                                if vidas <= 0:
                                    juego_terminado = True
                                else:
                                    reiniciar_nivel()
                                break
                                    
                    for puntos in puntos_activos[:]:
                        puntos['rect'].y -= 1  
                        puntos['timer'] -= 1  
                        if puntos['timer'] <= 0: puntos_activos.remove(puntos)

                    area_victoria = pauline.rect.inflate(80, 20)
                    if player.rect.colliderect(area_victoria):
                        victoria = True
                        pygame.mixer.music.stop()       
                        if canal_caminar.get_busy(): canal_caminar.stop()
                        if canal_martillo.get_busy(): canal_martillo.stop()
                        sonido_victoria.play()          

                        player.change_x = player.change_y = 0
                        player.is_jumping = player.climbing = False 
                        
                        ancho_mario = player.rect.width
                        alto_mario = player.rect.height
                        imagen_base = pygame.image.load(f"{MARIO_DIR}/mario.png").convert_alpha()
                        imagen_escalada = pygame.transform.scale(imagen_base, (ancho_mario, alto_mario))
                        player.image = pygame.transform.flip(imagen_escalada, True, False)
                        
                        posicion_x_junto_a_pauline = pauline.rect.right + 50 
                        player.rect = player.image.get_rect(midbottom=(posicion_x_junto_a_pauline, pauline.rect.bottom))

                        for b in barrels.sprites() + decorative_barrels.sprites(): b.kill()
                        for f in fireballs.sprites() + drum_flames.sprites(): f.kill()
                        barrels.empty()
                        decorative_barrels.empty()
                        fireballs.empty()
                        drum_flames.empty()

            else:
                if not pausado:
                    pauline.update()
                    if not corazon_creado:
                        nuevo_corazon = Corazon((player.rect.centerx + pauline.rect.centerx) // 2, pauline.rect.centery - 10)
                        grupo_corazon.add(nuevo_corazon)
                        corazon_creado = True
                    grupo_corazon.update()
                    
                    tiempo_cierre_victoria += 1
                    if tiempo_cierre_victoria >= 60 * 4: 
                        if nivel < 3:
                            nivel += 1
                            cargar_mapa(nivel)
                            reiniciar_nivel()
                            victoria = False
                            corazon_creado = False
                            for c in grupo_corazon: c.kill()
                            tiempo_cierre_victoria = 0
                        else:
                            running = False 

        # --- SECCIÓN DE DIBUJADO ---
        screen.fill(BLACK)
        screen.blit(background_image, (MARGIN, 0))

        COLOR_HUD = (255, 255, 255)
        BOX_X = 300                  
        Y_CORCHETES_1, Y_FILA_1, Y_FILA_1_NUM = 60, 65, 91           
        Y_CORCHETES_2, Y_FILA_2, Y_FILA_2_NUM = 115, 125, 151          

        c_izq = fuente_corchetes.render("[", True, COLOR_HUD)
        c_der = fuente_corchetes.render("]", True, COLOR_HUD)

        x_m = BOX_X + 20
        screen.blit(c_izq, (x_m, Y_CORCHETES_1))
        screen.blit(fuente_hud.render("M", True, COLOR_HUD), (x_m + 16, Y_FILA_1))
        screen.blit(fuente_hud.render(str(vidas), True, COLOR_HUD), (x_m + 16, Y_FILA_1_NUM))
        screen.blit(c_der, (x_m + 36, Y_CORCHETES_1))

        x_l = BOX_X + 75
        screen.blit(c_izq, (x_l, Y_CORCHETES_1))
        screen.blit(fuente_hud.render("L", True, COLOR_HUD), (x_l + 16, Y_FILA_1))
        screen.blit(fuente_hud.render(str(nivel), True, COLOR_HUD), (x_l + 16, Y_FILA_1_NUM))
        screen.blit(c_der, (x_l + 34, Y_CORCHETES_1))

        x_bonus = BOX_X
        screen.blit(c_izq, (x_bonus + 10, Y_CORCHETES_2))
        screen.blit(fuente_bonus.render("BONUS", True, COLOR_HUD), (x_bonus + 25, Y_FILA_2 + 4))
        screen.blit(fuente_hud.render(str(max(0, bonus)), True, COLOR_HUD), (x_bonus + 30, Y_FILA_2_NUM))
        screen.blit(c_der, (x_bonus + 115, Y_CORCHETES_2))

        for sprite in all_sprites:
            if sprite != player: screen.blit(sprite.image, sprite.rect)

        if juego_terminado and vidas <= 0: 
            frame_final = ULTIMO_FRAME_MUERTE if getattr(player, 'mirando_derecha', True) else pygame.transform.flip(ULTIMO_FRAME_MUERTE, True, False)
            screen.blit(frame_final, player.rect)
            
            pantalla_oscura = pygame.Surface((screen.get_width(), screen.get_height()))
            pantalla_oscura.set_alpha(170) 
            pantalla_oscura.fill((0, 0, 0)) 
            screen.blit(pantalla_oscura, (0, 0))
            
            texto_game_over = fuente.render("GAME OVER", True, (255, 0, 0)) 
            rect_texto = texto_game_over.get_rect(center=(screen.get_width() // 2, screen.get_height() // 2))
            screen.blit(texto_game_over, rect_texto)

            pygame.display.flip() 
            pygame.time.wait(3500) 
            running = False 
            continue 
        else:
            if getattr(player, 'has_hammer', False):
                 screen.blit(player.image, (player.rect.x - 14, player.rect.y - 32))
            else:
                 screen.blit(player.image, player.rect)

        if victoria and corazon_creado:
            for corazon in grupo_corazon: screen.blit(corazon.image, corazon.rect)

        for puntos in puntos_activos: 
            screen.blit(puntos['image'], puntos['rect'])

        if mostrar_paredes:
            for pared in invisible_walls:
                pygame.draw.rect(screen, (0, 255, 0), pared.rect, 3)

        if pausado:
            pantalla_oscura_pausa = pygame.Surface((screen.get_width(), screen.get_height()))
            pantalla_oscura_pausa.set_alpha(150) 
            pantalla_oscura_pausa.fill((0, 0, 0)) 
            screen.blit(pantalla_oscura_pausa, (0, 0))
            
            texto_pausa = fuente.render("PAUSA", True, (255, 255, 255)) 
            rect_pausa = texto_pausa.get_rect(center=(screen.get_width() // 2, screen.get_height() // 2))
            screen.blit(texto_pausa, rect_pausa)

        pygame.display.flip()
        clock.tick(60) 

pygame.quit()
